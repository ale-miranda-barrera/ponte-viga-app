# Ponte Viga — variables de entorno.
# Copiar a .env (o exportar en systemd/EC2) para producción.

# ── Almacenamiento ─────────────────────────────────────────────────
# Vacío → dev local (JSON files en data-files/)
# Ej: 'ponte-viga-data-dev' → DynamoDB
PONTE_VIGA_TABLE=
AWS_REGION=us-east-1

# ── AI Coach ───────────────────────────────────────────────────────
# Vacío → cae a heurísticas locales (rule-based)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Auth ───────────────────────────────────────────────────────────
# PIN del admin panel. CÁMBIALO EN PRODUCCIÓN.
PONTE_VIGA_ADMIN_PIN=1236

# ── CORS ───────────────────────────────────────────────────────────
# Vacío = solo mismo origen. Prod: 'https://ponteviga.duckdns.org'
PONTE_VIGA_ALLOWED_ORIGINS=

# ── Logging ────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

# ── Server ─────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
